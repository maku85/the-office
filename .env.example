# Copy to .env — `npm start` / `npm run dev` load it automatically.
# Every line is KEY=value (no `export`, no ${VAR} expansion). Unset = default.

# ── Local models ──────────────────────────────────────────────
# Default model for any role without a tier or explicit override.
OFFICE_MODEL=qwen3:8b

# Two tiers. Roles map to one of these:
#   heavy = manager, developer, qa, devops   (planning / code / review)
#   light = analyst, designer, writer, researcher   (spec / design / prose)
# Both default to OFFICE_MODEL. Typical 18 GB box:
OFFICE_MODEL_HEAVY=qwen3:8b
OFFICE_MODEL_LIGHT=qwen3:4b

# Pin one role (highest precedence). Uncomment as needed:
#OFFICE_MODEL_DEVELOPER=qwen3:14b
#OFFICE_MODEL_DESIGNER=qwen3:8b
#OFFICE_MODEL_MANAGER=qwen3:14b

# Route one role through a cloud endpoint with `cloud:<model>` (rest stay local).
# Set the endpoint + key below; works with any OpenAI-compatible API.
#OFFICE_MODEL_DEVELOPER=cloud:gpt-4o-mini
#OFFICE_MODEL_QA=cloud:gpt-4o-mini
#OFFICE_OPENAI_BASE_URL=https://api.openai.com/v1          # OpenAI
#OFFICE_OPENAI_BASE_URL=https://api.groq.com/openai/v1     # Groq (free tier)
#OFFICE_OPENAI_BASE_URL=https://openrouter.ai/api/v1       # OpenRouter (:free models)
#OFFICE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Gemini (free tier)
#OFFICE_OPENAI_API_KEY=...

# Older manager-only switch (equivalent to OFFICE_MODEL_MANAGER=cloud:...):
#OFFICE_MANAGER_PROVIDER=openai
#OFFICE_MANAGER_MODEL=gpt-4o-mini

# ── Other common knobs (see README for the full list) ─────────
#OLLAMA_HOST=http://127.0.0.1:11434
#OFFICE_OLLAMA_KEEP_ALIVE=30m   # keep both tiers resident between turns
#OFFICE_PORT=4317
#OFFICE_AUTOTASK=1              # submit a demo goal on boot (default: start idle)
#OFFICE_THINK=1                # keep model <think> traces
#OFFICE_PRICING=./pricing.json # $/1M-token prices → $ column in the Usage panel
#OFFICE_AUDIT=0                # disable the append-only audit log (default: on)
